{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build for nRF9160 DK nRF9160",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf9160dk@0.14.0/nrf9160",
                "CONFIG_DEBUG_OPTIMIZATIONS": true,
                "CONFIG_DEBUG_THREAD_INFO": true
            }
        }
    ]
}